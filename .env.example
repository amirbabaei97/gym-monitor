# Copy to .env (never commit it). Everything is optional.

# Domain Traefik routes to this container
DOMAIN=gym.amir.rocks

TZ=Europe/Berlin
SITE_TITLE=Gym Wall of Shame
WEEKLY_GOAL=3

# The page is public. These reveal more about where I am:
# "in the gym right now" while checked in
SHOW_LIVE=false
# studio names in the log
SHOW_STUDIOS=false

# Sync with Fitness First: SYNC_PER_DAY runs spread evenly from SYNC_FIRST_HOUR
# to SYNC_LAST_HOUR (local time), each moved randomly by up to ±SYNC_JITTER_MINUTES.
# Default: around 08:00, 11:30, 15:00, 18:30 and 22:00.
SYNC_PER_DAY=5
SYNC_FIRST_HOUR=8
SYNC_LAST_HOUR=22
SYNC_JITTER_MINUTES=20

# Hide check-ins before this date (YYYY-MM-DD); they stay in the database.
# Use it for stray early check-ins from before the app counted reliably.
DATA_START=

# Fitness First login (the app's e-mail + password). Used to log in to Netpulse
# and renew the 3-hour session. Keep this file mode 600 and out of git.
FF_USERNAME=
FF_PASSWORD=
